{
  "name": "transport-request-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transport request, approve, dispatch and track. Demo data only until live data is imported.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-pwa.mjs",
    "start": "node src/server.mjs",
