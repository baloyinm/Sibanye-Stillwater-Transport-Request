# Copy to .env (untracked) or set in the server environment. Never commit real values.
DATA_MODE=demo
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=
# Live mode only (DATA_MODE=live). Values live on the server, never in git.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Business settings: each answers a question in PLAN.md. Defaults shown. Change one line to answer it.
APPROVAL_CHAIN=single      # Q1: single | two (supervisor endorses, then controller approves)
PLACES_MODE=list           # Q2: list | free (type any address)
COST_CENTRE=off            # Q3: off | optional | required
VEHICLE_TYPES=Sedan,Bakkie,Minibus,Truck   # Q3
DRIVER_ACCEPT=auto         # Q4: auto | accept
NOTIFY=off                 # Q5: off | inapp | messages (messages = in-app plus email and SMS through COMMS_MODE; default redirect, test inbox only)
COMMS_MODE=redirect        # off | redirect | allowlist | live (live is refused unless COMMS_ENVIRONMENT=production)
COMMS_REDIRECT_EMAIL=      # test inbox for redirect mode
COMMS_REDIRECT_PHONE=      # test number for redirect mode
ORG_FILE=                  # path to the organisation details JSON (kept on the server)
APP_URL=                   # public address of the app, used in message links
ROUTING=straight           # Q6: straight | road (needs ROUTING_URL, an OSRM-compatible service)
ROUTING_URL=
TRACKING=phone             # Q7: phone | tracker (needs TRACKER_TOKEN, 16+ characters, kept on the server)
TRACKER_TOKEN=
ROTABLES=off               # Q9: off | on (parts requests)
RETENTION_DAYS=730         # Q10: used by scripts/retention.mjs (dry run unless --apply)
